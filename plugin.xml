<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- ===================== Commands ===================== -->
   <extension point="org.eclipse.ui.commands">
      <category
            id="io.github.palimkarakshay.abapadtmcp.category"
            name="abap-mcp"/>
      <command
            categoryId="io.github.palimkarakshay.abapadtmcp.category"
            id="io.github.palimkarakshay.abapadtmcp.commands.lint"
            name="Lint with abap-mcp"/>
      <command
            categoryId="io.github.palimkarakshay.abapadtmcp.category"
            id="io.github.palimkarakshay.abapadtmcp.commands.readiness"
            name="Cloud Readiness (abap-mcp)"/>
   </extension>

   <!-- ===================== Handlers ===================== -->
   <extension point="org.eclipse.ui.handlers">
      <handler
            class="io.github.palimkarakshay.abapadtmcp.handlers.AbapMcpLintHandler"
            commandId="io.github.palimkarakshay.abapadtmcp.commands.lint"/>
      <handler
            class="io.github.palimkarakshay.abapadtmcp.handlers.AbapMcpReadinessHandler"
            commandId="io.github.palimkarakshay.abapadtmcp.commands.readiness"/>
   </extension>

   <!--
      ===================== Menus =====================
      ADT contributes the ABAP source editor; its editor-context-menu id is
      "#TextEditorContext" (the standard Eclipse text-editor popup id that the ADT
      ABAP editor inherits) in the general case. We contribute to that popup so the
      commands appear when right-clicking inside an ABAP source editor, WITHOUT
      compiling against any com.sap.adt.* bundle.

      ASSUMPTION (documented): ADT's ABAP editor is an ITextEditor subclass and thus
      exposes the "#TextEditorContext" popup. If a given ADT release uses a custom
      popup id, add that id as an extra <menuContribution locationURI=...> here — the
      handler logic is unchanged. We also add a top-level "abap-mcp" pulldown so the
      commands are reachable regardless of editor popup wiring.
   -->
   <extension point="org.eclipse.ui.menus">
      <!-- ABAP / text editor context menu -->
      <menuContribution
            locationURI="popup:#TextEditorContext?after=additions"
            allPopups="false">
         <menu
               id="io.github.palimkarakshay.abapadtmcp.menu"
               label="abap-mcp">
            <command
                  commandId="io.github.palimkarakshay.abapadtmcp.commands.lint"
                  label="Lint with abap-mcp"
                  style="push"/>
            <command
                  commandId="io.github.palimkarakshay.abapadtmcp.commands.readiness"
                  label="Cloud Readiness"
                  style="push"/>
         </menu>
      </menuContribution>

      <!-- Always-available top-level menu (fallback / discoverability) -->
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="io.github.palimkarakshay.abapadtmcp.mainmenu"
               label="abap-mcp">
            <command
                  commandId="io.github.palimkarakshay.abapadtmcp.commands.lint"
                  label="Lint with abap-mcp"
                  style="push"/>
            <command
                  commandId="io.github.palimkarakshay.abapadtmcp.commands.readiness"
                  label="Cloud Readiness"
                  style="push"/>
         </menu>
      </menuContribution>
   </extension>

   <!-- ===================== Problem markers ===================== -->
   <extension
         id="abapMcpProblem"
         name="abap-mcp Problem"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="true"/>
   </extension>

</plugin>
