<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.8"?>
<!--
  Optional Eclipse PDE target-platform definition.

  Open this in the Eclipse "Target Platform" editor (Window > Preferences >
  Plug-in Development > Target Platform > Edit) and "Set as Active Target Platform"
  so the plugin compiles inside the IDE against the same bundles Tycho uses.

  For a build that links SAP ADT API, add SAP's ADT update site as another
  <location> here AND add the bundles to META-INF/MANIFEST.MF. The handlers are
  written so this is additive — no code change required to keep the decoupled build.
-->
<target name="abap-adt-mcp" sequenceNumber="1">
  <locations>
    <location includeAllPlatforms="false" includeConfigurePhase="true"
              includeMode="planner" includeSource="true" type="InstallableUnit">
      <repository location="https://download.eclipse.org/releases/2024-09/"/>
      <unit id="org.eclipse.ui" version="0.0.0"/>
      <unit id="org.eclipse.core.runtime" version="0.0.0"/>
      <unit id="org.eclipse.core.resources" version="0.0.0"/>
      <unit id="org.eclipse.jface.text" version="0.0.0"/>
      <unit id="org.eclipse.ui.workbench.texteditor" version="0.0.0"/>
      <unit id="org.eclipse.ui.editors" version="0.0.0"/>
      <unit id="org.eclipse.sdk.feature.group" version="0.0.0"/>
    </location>
  </locations>
  <environment>
    <ee>JavaSE-17</ee>
  </environment>
</target>
